# Copy this file to .env. Fill in the blank values before starting Docker.
# Generate different random values for the database password and JWT key.
# See docs/GETTING_STARTED.md for a PowerShell generation command.
POSTGRES_PASSWORD=
JWT_KEY=

# Optional: supply BOTH to create the first staff account.
# Use your chosen email and a strong, unique password. No account is preconfigured.
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
